diff --git a/todo_api/repository.py b/todo_api/repository.py
new file mode 100644
--- /dev/null
+++ b/todo_api/repository.py
@@ -0,0 +1,41 @@
+from dataclasses import dataclass
+
+from . import db
+
+
+@dataclass
+class TodoRepository:
+    """All SQL for the todos table, scoped to a single owner."""
+
+    owner: str
+
+    def page(self, limit, offset):
+        return db.get_db().execute(
+            "SELECT * FROM todos WHERE owner = ? ORDER BY id LIMIT ? OFFSET ?",
+            (self.owner, limit, offset),
+        ).fetchall()
+
+    def get(self, todo_id):
+        return db.get_db().execute(
+            "SELECT * FROM todos WHERE id = ? AND owner = ?", (todo_id, self.owner)
+        ).fetchone()
+
+    def create(self, title):
+        conn = db.get_db()
+        cur = conn.execute("INSERT INTO todos (owner, title) VALUES (?, ?)", (self.owner, title))
+        conn.commit()
+        return self.get(cur.lastrowid)
+
+    def set_done(self, todo_id, done):
+        conn = db.get_db()
+        conn.execute(
+            "UPDATE todos SET done = ? WHERE id = ? AND owner = ?", (int(done), todo_id, self.owner)
+        )
+        conn.commit()
+        return self.get(todo_id)
+
+    def delete(self, todo_id):
+        conn = db.get_db()
+        cur = conn.execute("DELETE FROM todos WHERE id = ? AND owner = ?", (todo_id, self.owner))
+        conn.commit()
+        return cur.rowcount > 0
diff --git a/tests/test_repository.py b/tests/test_repository.py
new file mode 100644
--- /dev/null
+++ b/tests/test_repository.py
@@ -0,0 +1,13 @@
+from todo_api import create_app
+from todo_api.repository import TodoRepository
+
+
+def test_repository_is_scoped_to_owner(tmp_path):
+    app = create_app({"DATABASE": str(tmp_path / "repo.sqlite3")})
+    with app.app_context():
+        alice, bob = TodoRepository("alice"), TodoRepository("bob")
+        todo = alice.create("Write report")
+        assert bob.get(todo["id"]) is None
+        assert bob.delete(todo["id"]) is False
+        assert alice.set_done(todo["id"], True)["done"] == 1
+        assert [r["title"] for r in alice.page(10, 0)] == ["Write report"]
