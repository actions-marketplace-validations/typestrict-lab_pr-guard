     def list_todos():
         page = max(request.args.get("page", 1, type=int), 1)
         offset = (page - 1) * PAGE_SIZE
+        query = "SELECT * FROM todos WHERE owner = ?"
+        params = [g.user]
+        done = request.args.get("done")
+        if done is not None:
+            if done not in ("true", "false"):
+                return jsonify(error="done must be true or false"), 400
+            query += " AND done = ?"
+            params.append(int(done == "true"))
         rows = db.get_db().execute(
-            "SELECT * FROM todos WHERE owner = ? ORDER BY id LIMIT ? OFFSET ?",
-            (g.user, PAGE_SIZE, offset),
+            query + " ORDER BY id LIMIT ? OFFSET ?",
+            (*params, PAGE_SIZE, offset),
