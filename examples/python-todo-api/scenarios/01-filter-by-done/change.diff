         return jsonify([to_json(r) for r in rows])
 
diff --git a/tests/test_app.py b/tests/test_app.py
--- a/tests/test_app.py
+++ b/tests/test_app.py
@@ -42,3 +42,18 @@
     todo = client.post("/todos", json={"title": "Ship it"}, headers=auth("alice")).get_json()
     resp = client.patch(f"/todos/{todo['id']}", json={"done": True}, headers=auth("alice"))
     assert resp.get_json()["done"] is True
+
+
+def test_filter_by_done(client):
+    first = client.post("/todos", json={"title": "Open"}, headers=auth("alice")).get_json()
+    second = client.post("/todos", json={"title": "Finished"}, headers=auth("alice")).get_json()
+    client.patch(f"/todos/{second['id']}", json={"done": True}, headers=auth("alice"))
+
+    open_items = client.get("/todos?done=false", headers=auth("alice")).get_json()
+    finished = client.get("/todos?done=true", headers=auth("alice")).get_json()
+    assert [t["id"] for t in open_items] == [first["id"]]
+    assert [t["id"] for t in finished] == [second["id"]]
+
+
+def test_filter_rejects_unknown_value(client):
+    assert client.get("/todos?done=maybe", headers=auth("alice")).status_code == 400
