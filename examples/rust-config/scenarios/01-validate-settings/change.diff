+
+#[test]
+fn rejects_zero_workers_and_timeout() {
+    let dir = temp_dir("invalid");
+    write_profile(&dir, "workers", "database_url = \"x\"\nworkers = 0\n");
+    write_profile(&dir, "timeout", "database_url = \"x\"\nrequest_timeout = \"0s\"\n");
+    assert!(matches!(load(&dir, "workers"), Err(LoadError::Invalid { .. })));
+    assert!(matches!(load(&dir, "timeout"), Err(LoadError::Invalid { .. })));
+}
