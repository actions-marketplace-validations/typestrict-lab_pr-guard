@@ -0,0 +1,29 @@
+/// A validated profile name: ASCII letters, digits, `-` and `_` only, so the
+/// file it names always stays inside the config directory.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProfileName(String);
+
+impl ProfileName {
+    pub fn parse(raw: &str) -> Option<Self> {
+        let valid = !raw.is_empty()
+            && raw.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_');
+        valid.then(|| Self(raw.to_string()))
+    }
+
+    pub fn file_name(&self) -> String {
+        format!("{}.toml", self.0)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ProfileName;
+
+    #[test]
+    fn accepts_simple_names_only() {
+        assert_eq!(ProfileName::parse("prod-eu_1").unwrap().file_name(), "prod-eu_1.toml");
+        for bad in ["", "../prod", "a/b", "prod.toml", "dev "] {
+            assert!(ProfileName::parse(bad).is_none(), "{bad:?} should be rejected");
+        }
+    }
+}
