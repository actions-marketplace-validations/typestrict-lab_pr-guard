@@ -0,0 +1,26 @@
+require "time"
+require_relative "post"
+
+# Turns posts into hashes for the API and for the JSON file, and back.
+module PostSerializer
+  module_function
+
+  def summary(post)
+    { id: post.id, title: post.title, author: post.author, published_at: post.published_at&.iso8601,
+      excerpt: post.excerpt }
+  end
+
+  def full(post)
+    summary(post).merge(body: post.body)
+  end
+
+  def storage(post)
+    summary(post).except(:excerpt).merge(body: post.body)
+  end
+
+  def from_storage(attrs)
+    published_at = attrs["published_at"] && Time.iso8601(attrs["published_at"])
+    Post.new(id: attrs["id"], title: attrs["title"], body: attrs["body"],
+             author: attrs["author"], published_at: published_at)
+  end
+end
