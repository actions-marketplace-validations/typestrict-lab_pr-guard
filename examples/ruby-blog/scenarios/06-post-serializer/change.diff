diff --git a/test/post_serializer_test.rb b/test/post_serializer_test.rb
new file mode 100644
--- /dev/null
+++ b/test/post_serializer_test.rb
@@ -0,0 +1,19 @@
+require "json"
+require "minitest/autorun"
+require_relative "../lib/post_serializer"
+
+class PostSerializerTest < Minitest::Test
+  def test_storage_round_trip
+    post = Post.new(id: "p1", title: "Hello", body: "Hello world", author: "ana",
+                    published_at: Time.utc(2024, 5, 1, 12))
+    copy = PostSerializer.from_storage(JSON.parse(PostSerializer.storage(post).to_json))
+    assert_equal [post.id, post.title, post.body, post.author, post.published_at],
+                 [copy.id, copy.title, copy.body, copy.author, copy.published_at]
+  end
+
+  def test_summary_has_excerpt_but_no_body
+    summary = PostSerializer.summary(Post.new(id: "p1", title: "Hello", body: "Hello world", author: "ana"))
+    assert_equal "Hello world", summary[:excerpt]
+    refute summary.key?(:body)
+  end
+end
