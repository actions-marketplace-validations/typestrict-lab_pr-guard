diff --git a/limiter.go b/limiter.go
--- a/limiter.go
+++ b/limiter.go
@@ -28,15 +28,21 @@
 
 // Allow reports whether one request for key may proceed now, consuming a token if so.
 func (l *Limiter) Allow(key string) bool {
+	ok, _ := l.Take(key)
+	return ok
+}
+
+// Take is like Allow, but when the request is limited it also reports how long until a token is free.
+func (l *Limiter) Take(key string) (bool, time.Duration) {
 	l.mu.Lock()
 	defer l.mu.Unlock()
 
 	b := l.refill(key)
 	if b.tokens < 1 {
-		return false
+		return false, time.Duration((1 - b.tokens) / l.rate * float64(time.Second))
 	}
 	b.tokens--
-	return true
+	return true, 0
 }
 
 // refill returns the bucket for key with the tokens earned since its last use. Callers hold l.mu.
