-	return &Limiter{rate: rate, burst: float64(burst), now: time.Now, buckets: make(map[string]*bucket)}
+// Config describes a limiter.
+type Config struct {
+	// Rate is the number of requests per second each key earns.
+	Rate float64
+	// Burst is the most requests a key can make at once.
+	Burst int
+	// Clock returns the current time; nil means time.Now.
+	Clock func() time.Time
+}
+
+// New returns a limiter for cfg.
+func New(cfg Config) *Limiter {
+	clock := cfg.Clock
+	if clock == nil {
+		clock = time.Now
+	}
+	return &Limiter{rate: cfg.Rate, burst: float64(cfg.Burst), now: clock, buckets: make(map[string]*bucket)}
 }
 
