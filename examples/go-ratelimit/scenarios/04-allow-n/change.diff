+// AllowN reports whether a request costing n tokens may proceed now, consuming them if so.
+func (l *Limiter) AllowN(key string, n int) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	b := l.refill(key)
+	if b.tokens < float64(n-1) {
+		return false
+	}
+	b.tokens -= float64(n)
+	return true
+}
