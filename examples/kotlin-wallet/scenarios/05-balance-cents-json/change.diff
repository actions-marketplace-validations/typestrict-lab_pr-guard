@@ -0,0 +1,14 @@
+package wallet
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+class WalletJsonTest {
+    @Test
+    fun `balance is serialized in cents with an explicit name`() {
+        val json = Json.encodeToString(Wallet("a", "alice", 1_50, "USD"))
+        assertEquals("""{"id":"a","owner_id":"alice","balance_cents":150,"currency":"USD"}""", json)
+    }
+}
