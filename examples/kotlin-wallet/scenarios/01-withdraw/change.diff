-        if (from.ownerId != callerId) throw Forbidden("caller does not own wallet $fromId")
-        if (!PinHasher.verify(pin, pins.getValue(fromId))) throw Forbidden("wrong PIN")
+        authorize(callerId, from, pin)
         if (from.balanceCents < amountCents) throw InsufficientFunds(fromId)
 
         val credited = convert(amountCents, from.currency, to.currency)
         wallets[fromId] = from.copy(balanceCents = from.balanceCents - amountCents)
         wallets[toId] = to.copy(balanceCents = to.balanceCents + credited)
         return credited
+    }
+
+    /** Takes money out of a wallet, for payouts to the owner's bank account. */
+    fun withdraw(callerId: String, id: String, amountCents: Long, pin: String): Wallet {
+        require(amountCents > 0) { "withdrawal must be positive" }
+        val wallet = get(id)
+        authorize(callerId, wallet, pin)
+        if (wallet.balanceCents < amountCents) throw InsufficientFunds(id)
+        return wallet.copy(balanceCents = wallet.balanceCents - amountCents).also { wallets[id] = it }
+    }
+
+    private fun authorize(callerId: String, wallet: Wallet, pin: String) {
+        if (wallet.ownerId != callerId) throw Forbidden("caller does not own wallet ${wallet.id}")
+        if (!PinHasher.verify(pin, pins.getValue(wallet.id))) throw Forbidden("wrong PIN")
     }
 
